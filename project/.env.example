# =========================
# SUPABASE CONFIG
# =========================
SUPABASE_URL=        # ví dụ: https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=   # dùng cho AuthService (login, signup, OTP)

# =========================
# DATABASE (Postgres via JDBC)
# =========================
SUPABASE_DB_URL=     # ví dụ: jdbc:postgresql://db.xyzcompany.supabase.co:5432/postgres
SUPABASE_DB_USER=    # thường là "postgres"
SUPABASE_DB_PASS=    # password do Supabase cung cấp trong phần Project Settings -> Database

# =========================
# ADMIN EMAIL CONFIG
# =========================
# cấu trúc sẽ là: "admin1@gmail.com:appPassword1,admin2@gmail.com:appPassword2"
# app password = tạo trong Google Account (cần bật 2FA)
ADMIN_GMAILS=
