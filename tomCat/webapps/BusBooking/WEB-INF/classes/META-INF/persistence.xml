<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" version="2.2">
  <persistence-unit name="busBookingPU" transaction-type="RESOURCE_LOCAL">
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <!-- Khai báo các entity -->
    <class>com.busbooking.model.AppUser</class>
    <class>com.busbooking.model.DriverTransport</class>
    <class>com.busbooking.model.LoginLog</class>
    <class>com.busbooking.model.TransportCompany</class>
    <!-- <class>com.busbooking.model.TripDetail</class> -->
    <class>com.busbooking.model.TripTransport</class>
    <class>com.busbooking.model.TripTransportStatusLog</class>
    <class>com.busbooking.model.VehicleTransport</class>

    <properties>
  <!-- Hiển thị câu lệnh SQL -->
  <property name="hibernate.show_sql" value="true"/>
  <property name="hibernate.format_sql" value="true"/>
  <property name="hibernate.use_sql_comments" value="true"/>

  <!-- Log các giá trị tham số truyền vào câu SQL -->
  <property name="hibernate.type" value="trace"/>
</properties>

  </persistence-unit>
</persistence>
